diff --git a/lib/auth-rate-limit.js b/lib/auth-rate-limit.js
new file mode 100644
index 0000000..25f6a56
--- /dev/null
+++ b/lib/auth-rate-limit.js
@@ -0,0 +1,143 @@
+"use strict";
+
+const { BlockList, isIP } = require("node:net");
+const { hashToken } = require("./auth");
+const { withRedemptionTransaction } = require("./auth-recovery");
+
+const WINDOW_MS = 15 * 60_000;
+const MAX_BUCKETS = 20_000;
+
+function normalizeIdentifier(value) {
+  return String(value || "").trim().toLowerCase();
+}
+
+function normalizeIp(value) {
+  if (typeof value !== "string" || !isIP(value) || value.includes("%")) return null;
+  if (isIP(value) === 4) return value;
+  const canonical = new URL(`http://[${value}]`).hostname.slice(1, -1);
+  const mapped = /^::ffff:([0-9a-f]+):([0-9a-f]+)$/.exec(canonical);
+  if (!mapped) return canonical;
+  const high = parseInt(mapped[1], 16);
+  const low = parseInt(mapped[2], 16);
+  return [high >> 8, high & 255, low >> 8, low & 255].join(".");
+}
+
+function createAuthIpResolver({ mode, trustedProxyCidrs }) {
+  if (mode === "direct") return (req) => normalizeIp(req.socket.remoteAddress);
+  if (mode !== "render") return () => null;
+
+  const peers = new BlockList();
+  const cidrs = String(trustedProxyCidrs || "").split(",").map((value) => value.trim()).filter(Boolean);
+  if (!cidrs.length) return () => null;
+  for (const cidr of cidrs) {
+    const [address, prefix, extra] = cidr.split("/");
+    const family = isIP(address);
+    const max = family === 4 ? 32 : 128;
+    if (!family || extra !== undefined || !/^\d+$/.test(prefix || "") || Number(prefix) < 1 || Number(prefix) > max) {
+      throw new Error("Invalid AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS");
+    }
+    peers.addSubnet(address, Number(prefix), family === 4 ? "ipv4" : "ipv6");
+  }
+  return (req) => {
+    const peer = normalizeIp(req.socket.remoteAddress);
+    if (!peer || !peers.check(peer, isIP(peer) === 4 ? "ipv4" : "ipv6")) return null;
+    // Enable this mode only after verifying every trusted ingress overwrites
+    // CF-Connecting-IP. Never fall back to an unverified forwarding header.
+    return normalizeIp(req.headers["cf-connecting-ip"]);
+  };
+}
+
+function bucket(kind, identity, max, windowMs = WINDOW_MS) {
+  return { key: hashToken(JSON.stringify([kind, identity])), kind, max, windowMs };
+}
+
+const limits = {
+  loginVolume: (ip) => ip && bucket("login-ip", ip, 30),
+  loginFailures: (identity, ip) => [
+    bucket(identity[0] === "identifier" ? "login-unknown" : "login-account", identity, 15),
+    ...(ip ? [bucket(identity[0] === "identifier" ? "login-unknown-pair" : "login-pair", [identity, ip], 5)] : []),
+  ],
+  recoveryVolume: (ip) => ip && bucket("forgot-ip", ip, 10),
+  recoveryAddress: (email) => bucket("forgot-address", email, 1, 5 * 60_000),
+  resetVolume: (ip) => ip && bucket("reset-ip", ip, 20),
+  resetToken: (token) => bucket("reset-token", token, 6),
+};
+
+async function ensureAuthRateLimitSchema(run) {
+  await run(`CREATE TABLE IF NOT EXISTS auth_rate_limits (
+    bucketKey TEXT PRIMARY KEY,
+    kind TEXT NOT NULL,
+    count INTEGER NOT NULL,
+    expiresAt INTEGER NOT NULL
+  )`);
+  await run("CREATE INDEX IF NOT EXISTS idx_auth_rate_limits_expires ON auth_rate_limits(expiresAt)");
+  await run("CREATE INDEX IF NOT EXISTS idx_auth_rate_limits_kind_expires ON auth_rate_limits(kind, expiresAt)");
+}
+
+function createAuthRateLimiter(filename, now = Date.now, maxBuckets = MAX_BUCKETS) {
+  let tail = Promise.resolve();
+  const transact = (work) => {
+    const result = tail.then(() => withRedemptionTransaction(filename, work));
+    tail = result.catch(() => {});
+    return result;
+  };
+  const retry = (expiry, time) => Math.max(1, Math.ceil((expiry - time) / 1000));
+
+  return {
+    take(volume, restrictions) {
+      return transact(async ({ get, run }) => {
+        const time = now();
+        await run("DELETE FROM auth_rate_limits WHERE expiresAt <= ?", [time]);
+        const load = (item) => get("SELECT count, expiresAt FROM auth_rate_limits WHERE bucketKey = ?", [item.key]);
+        const charge = (item) => run(
+          `INSERT INTO auth_rate_limits (bucketKey, kind, count, expiresAt) VALUES (?, ?, 1, ?)
+           ON CONFLICT(bucketKey) DO UPDATE SET count = count + 1`,
+          [item.key, item.kind, time + item.windowMs]
+        );
+        const overCapacity = async (kind) => {
+          const { count } = await get("SELECT COUNT(*) AS count FROM auth_rate_limits WHERE kind = ?", [kind]);
+          if (count < maxBuckets) return null;
+          const oldest = await get("SELECT expiresAt FROM auth_rate_limits WHERE kind = ? ORDER BY expiresAt LIMIT 1", [kind]);
+          return retry(oldest?.expiresAt || time + 60_000, time);
+        };
+        if (volume) {
+          const current = await load(volume);
+          const wait = current?.count >= volume.max ? retry(current.expiresAt, time) : !current ? await overCapacity(volume.kind) : null;
+          if (wait) return { retryAfter: wait, volumeLimited: true };
+          await charge(volume);
+        }
+        let wait = 0;
+        const newKinds = [];
+        for (const restriction of restrictions) {
+          const current = await load(restriction);
+          if (!current) newKinds.push(restriction.kind);
+          else if (current.count >= restriction.max) wait = Math.max(wait, retry(current.expiresAt, time));
+        }
+        if (wait) return { retryAfter: wait, volumeLimited: false };
+        for (const kind of newKinds) {
+          const capacityWait = await overCapacity(kind);
+          if (capacityWait) return { retryAfter: capacityWait, volumeLimited: true };
+        }
+        for (const restriction of restrictions) await charge(restriction);
+        return null;
+      });
+    },
+    clearFailures(restrictions) {
+      return transact(async ({ run }) => {
+        for (const restriction of restrictions) {
+          await run("DELETE FROM auth_rate_limits WHERE bucketKey = ?", [restriction.key]);
+        }
+      });
+    },
+  };
+}
+
+function sendAuthRestriction(res, retryAfter) {
+  res.set("Retry-After", String(retryAfter));
+  res.set("Cache-Control", "no-store");
+  return res.status(429).send("Too many attempts. Please wait a few minutes and try again.");
+}
+
+module.exports = {
+  createAuthIpResolver, createAuthRateLimiter, ensureAuthRateLimitSchema, limits, normalizeIdentifier, sendAuthRestriction,
+};
diff --git a/lib/auth-recovery.js b/lib/auth-recovery.js
new file mode 100644
index 0000000..7d3251c
--- /dev/null
+++ b/lib/auth-recovery.js
@@ -0,0 +1,60 @@
+"use strict";
+
+const sqlite3 = require("sqlite3");
+
+const TOKEN_UNEXPIRED = "julianday(expiresAt) > julianday('now')";
+
+function recoveryLink(path, parameter, token) {
+  const configured = String(process.env.DASHBOARD_ORIGIN || "").trim();
+  if (!/^https:\/\/[^/?#@\\\s]+\/?$/i.test(configured)) return null;
+  try {
+    const origin = new URL(configured).origin;
+    const link = new URL(path, origin);
+    link.searchParams.set(parameter, token);
+    return link.href;
+  } catch {
+    return null;
+  }
+}
+
+function protectTokenPage(res) {
+  res.set("Cache-Control", "no-store");
+  res.set("Referrer-Policy", "no-referrer");
+}
+
+// Keep awaited redemption statements isolated from other application writes
+// on the shared SQLite connection. SQLite arbitrates competing writers.
+async function withRedemptionTransaction(filename, work) {
+  const connection = await new Promise((resolve, reject) => {
+    const db = new sqlite3.Database(filename, sqlite3.OPEN_READWRITE, (error) => {
+      if (error) reject(error);
+      else resolve(db);
+    });
+  });
+  connection.configure("busyTimeout", 5000);
+  const run = (sql, params = []) => new Promise((resolve, reject) => {
+    connection.run(sql, params, function (error) {
+      if (error) reject(error);
+      else resolve(this.changes);
+    });
+  });
+  const get = (sql, params) => new Promise((resolve, reject) => {
+    connection.get(sql, params, (error, row) => error ? reject(error) : resolve(row));
+  });
+  try {
+    await run("PRAGMA foreign_keys = ON");
+    await run("BEGIN IMMEDIATE");
+    try {
+      const result = await work({ run, get });
+      await run("COMMIT");
+      return result;
+    } catch (error) {
+      await run("ROLLBACK").catch(() => {});
+      throw error;
+    }
+  } finally {
+    await new Promise((resolve) => connection.close(resolve));
+  }
+}
+
+module.exports = { recoveryLink, protectTokenPage, TOKEN_UNEXPIRED, withRedemptionTransaction };
diff --git a/lib/auth-sessions.js b/lib/auth-sessions.js
new file mode 100644
index 0000000..a662bd8
--- /dev/null
+++ b/lib/auth-sessions.js
@@ -0,0 +1,124 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const { hashToken } = require("./auth");
+const { normalizeStoredRole } = require("./roles");
+const { withRedemptionTransaction } = require("./auth-recovery");
+
+async function ensureSessionIdentitySchema({ all, run }) {
+  const sessions = new Set((await all("PRAGMA table_info(auth_sessions)")).map(({ name }) => name));
+  if (!sessions.has("userId")) await run("ALTER TABLE auth_sessions ADD COLUMN userId INTEGER");
+  if (!sessions.has("principalType")) await run("ALTER TABLE auth_sessions ADD COLUMN principalType TEXT");
+  await run("CREATE INDEX IF NOT EXISTS idx_auth_sessions_user_id ON auth_sessions(userId)");
+
+  const users = new Set((await all("PRAGMA table_info(users)")).map(({ name }) => name));
+  if (!users.has("bootstrapIdentity")) await run("ALTER TABLE users ADD COLUMN bootstrapIdentity TEXT");
+  await run("CREATE UNIQUE INDEX IF NOT EXISTS idx_users_bootstrap_identity ON users(bootstrapIdentity) WHERE bootstrapIdentity IS NOT NULL");
+}
+
+function revokeAccountSessions(run, userId) {
+  return run("DELETE FROM auth_sessions WHERE userId = ?", [userId]);
+}
+
+function createSessionStore({ get, filename, bootstrapUser, ttlMs }) {
+  const bootstrapIdentity = hashToken(bootstrapUser);
+
+  async function createAccountSession(account, upgradedHash = null) {
+    const token = crypto.randomUUID();
+    // A stale credential snapshot can neither overwrite a reset password nor
+    // issue a new session. Upgrade and session issuance commit together.
+    const changed = await withRedemptionTransaction(filename, async ({ run }) => {
+      if (upgradedHash) {
+        const upgraded = await run(
+          "UPDATE users SET passwordHash = ? WHERE id = ? AND passwordHash = ? AND bootstrapIdentity IS NULL",
+          [upgradedHash, account.id, account.passwordHash]
+        );
+        if (!upgraded) return 0;
+      }
+      const issued = await run(
+        `INSERT INTO auth_sessions (tokenHash, user, role, city, exp, userId, principalType)
+         SELECT ?, COALESCE(NULLIF(username, ''), email, 'user'), COALESCE(role, 'organizer'),
+                COALESCE(city, 'Enumclaw'), ?, id, 'account'
+           FROM users WHERE id = ? AND passwordHash = ? AND bootstrapIdentity IS NULL`,
+        [hashToken(token), Date.now() + ttlMs, account.id, upgradedHash || account.passwordHash]
+      );
+      if (upgradedHash && issued !== 1) throw new Error("Upgraded session could not be issued");
+      return issued;
+    });
+    return changed === 1 ? token : null;
+  }
+
+  async function createBootstrapSession() {
+    const token = crypto.randomUUID();
+    return withRedemptionTransaction(filename, async ({ get, run }) => {
+      let profile = await get("SELECT id, role, city FROM users WHERE bootstrapIdentity = ?", [bootstrapIdentity]);
+      if (!profile) {
+        // A passwordless Developer with this exact username and no email is
+        // the old bootstrap profile, provided no other account uses its alias.
+        const aliases = [bootstrapUser, bootstrapUser];
+        const oldProfile = await get(
+          `SELECT id, role, city FROM users
+            WHERE username = ? AND role = 'developer' AND COALESCE(passwordHash, '') = ''
+              AND COALESCE(email, '') = '' AND bootstrapIdentity IS NULL
+              AND (SELECT COUNT(*) FROM users WHERE lower(username) = lower(?) OR lower(email) = lower(?)) = 1`,
+          [bootstrapUser, ...aliases]
+        );
+        if (oldProfile) {
+          await run("UPDATE users SET bootstrapIdentity = ? WHERE id = ?", [bootstrapIdentity, oldProfile.id]);
+          profile = oldProfile;
+        } else {
+          const occupied = await get(
+            "SELECT id FROM users WHERE lower(username) = lower(?) OR lower(email) = lower(?) LIMIT 1",
+            aliases
+          );
+          const username = occupied ? `${bootstrapUser} (bootstrap ${crypto.randomUUID()})` : bootstrapUser;
+          await run(
+            "INSERT INTO users (username, passwordHash, role, city, bootstrapIdentity) VALUES (?, '', 'developer', 'Enumclaw', ?)",
+            [username, bootstrapIdentity]
+          );
+          profile = await get("SELECT id, role, city FROM users WHERE bootstrapIdentity = ?", [bootstrapIdentity]);
+        }
+      }
+      if (normalizeStoredRole(profile.role) !== "developer") return null;
+      await run(
+        `INSERT INTO auth_sessions (tokenHash, user, role, city, exp, userId, principalType)
+         VALUES (?, ?, 'developer', ?, ?, ?, 'bootstrap')`,
+        [hashToken(token), bootstrapUser, profile.city || "Enumclaw", Date.now() + ttlMs, profile.id]
+      );
+      return token;
+    });
+  }
+
+  async function restore(token) {
+    if (!token) return null;
+    // SQLite is authoritative on every request so no worker can resurrect a
+    // revoked session from an identity cached before the transaction committed.
+    const row = await get(
+      `SELECT u.id, u.username, u.email, u.role, u.city, s.principalType
+         FROM auth_sessions s JOIN users u ON u.id = s.userId
+        WHERE s.tokenHash = ? AND s.exp > ? AND (
+          (s.principalType = 'account' AND u.bootstrapIdentity IS NULL)
+          OR (s.principalType = 'bootstrap' AND u.bootstrapIdentity = ? AND s.user = ? AND u.role = 'developer')
+        )`,
+      [hashToken(token), Date.now(), bootstrapIdentity, bootstrapUser]
+    );
+    if (!row) return null;
+    return {
+      userId: row.id,
+      principalType: row.principalType,
+      user: row.username || row.email || "user",
+      role: normalizeStoredRole(row.role),
+      city: row.city || "Enumclaw",
+    };
+  }
+
+  return {
+    createAccountSession,
+    createBootstrapSession,
+    restore,
+    destroy: (token) => token && withRedemptionTransaction(filename, ({ run }) =>
+      run("DELETE FROM auth_sessions WHERE tokenHash = ?", [hashToken(token)])),
+  };
+}
+
+module.exports = { createSessionStore, ensureSessionIdentitySchema, revokeAccountSessions };
diff --git a/tests/auth-passwords.test.js b/tests/auth-passwords.test.js
new file mode 100644
index 0000000..0299b99
--- /dev/null
+++ b/tests/auth-passwords.test.js
@@ -0,0 +1,27 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const { pbkdf2Sync } = require("node:crypto");
+const test = require("node:test");
+const { hashPassword, needsPasswordUpgrade, passwordLengthError, verifyPassword } = require("../lib/auth");
+
+test("PBKDF2 retains legacy verification and writes versioned, independently salted hashes", async () => {
+  const password = "  a long unicode passphrase ☕ ".repeat(16);
+  const salt = "a".repeat(32);
+  const legacy = salt + ":" + pbkdf2Sync(password, salt, 120_000, 32, "sha256").toString("hex");
+  assert.ok(await verifyPassword(password, legacy));
+  assert.equal(await verifyPassword(password.trim(), legacy), false);
+  assert.ok(needsPasswordUpgrade(legacy));
+
+  const hashes = await Promise.all([hashPassword(password), hashPassword(password)]);
+  assert.match(hashes[0], /^pbkdf2-sha256:v1:600000:[a-f0-9]{32}:[a-f0-9]{64}$/);
+  assert.notEqual(hashes[0], hashes[1]);
+  assert.equal(needsPasswordUpgrade(hashes[0]), false);
+  assert.ok(await verifyPassword(password, hashes[0]));
+  assert.equal(await verifyPassword("incorrect", hashes[0]), false);
+  assert.equal(await verifyPassword(password, hashes[0].replace(":600000:", ":9999999:")), false);
+  assert.equal(await verifyPassword(password, hashes[0].replace(":v1:", ":v2:")), false);
+  assert.equal(passwordLengthError("x".repeat(7)), "password_short");
+  assert.equal(passwordLengthError("x".repeat(256)), null);
+  assert.equal(passwordLengthError("x".repeat(257)), "password_long");
+});
diff --git a/tests/auth-rate-limit.test.js b/tests/auth-rate-limit.test.js
new file mode 100644
index 0000000..acddb40
--- /dev/null
+++ b/tests/auth-rate-limit.test.js
@@ -0,0 +1,68 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const sqlite3 = require("sqlite3");
+const { createAuthIpResolver, createAuthRateLimiter, ensureAuthRateLimitSchema, limits } = require("../lib/auth-rate-limit");
+
+test("auth IP resolution ignores spoofed headers outside verified ingress", () => {
+  const req = {
+    socket: { remoteAddress: "::ffff:192.0.2.4" },
+    ip: "203.0.113.9",
+    headers: { "x-forwarded-for": "203.0.113.9", "cf-connecting-ip": "203.0.113.9" },
+  };
+  assert.equal(createAuthIpResolver({})(req), null);
+  assert.equal(createAuthIpResolver({ mode: "direct" })(req), "192.0.2.4");
+  const renderIp = createAuthIpResolver({ mode: "render", trustedProxyCidrs: "192.0.2.0/24" });
+  assert.equal(renderIp(req), "203.0.113.9");
+  assert.equal(renderIp({ ...req, socket: { remoteAddress: "198.51.100.5" } }), null);
+  assert.equal(renderIp({ ...req, headers: { "x-forwarded-for": req.ip } }), null);
+  assert.equal(renderIp({ ...req, headers: { "cf-connecting-ip": "203.0.113.9, 203.0.113.12" } }), null);
+});
+
+test("SQLite limiter serializes attempts, persists windows, expires and bounds buckets", async (t) => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "opencircle-rate-limit-"));
+  const file = path.join(directory, "limits.db");
+  const db = new sqlite3.Database(file);
+  t.after(async () => {
+    await new Promise((resolve) => db.close(resolve));
+    fs.rmSync(directory, { recursive: true, force: true });
+  });
+  await ensureAuthRateLimitSchema((sql) => new Promise((resolve, reject) => {
+    db.run(sql, (error) => error ? reject(error) : resolve());
+  }));
+
+  let time = 1000;
+  const first = createAuthRateLimiter(file, () => time);
+  const second = createAuthRateLimiter(file, () => time);
+  const ip = "192.0.2.10";
+  const volume = limits.loginVolume(ip);
+  const account = limits.loginFailures(["user", 1], ip);
+  const attempts = await Promise.all(Array.from({ length: 8 }, (_, index) =>
+    (index % 2 ? first : second).take(volume, account)));
+  assert.equal(attempts.filter((value) => value === null).length, 5);
+  assert.deepEqual(await second.take(volume, account), { retryAfter: 900, volumeLimited: false });
+  assert.equal(await second.take(volume, limits.loginFailures(["user", 2], ip)), null);
+  await first.clearFailures(account);
+  assert.equal(await second.take(volume, account), null);
+  for (let i = 0; i < 19; i++) assert.equal(await first.take(volume, []), null);
+  assert.deepEqual(await second.take(volume, []), { retryAfter: 900, volumeLimited: true });
+  time += 899_001;
+  assert.equal((await first.take(volume, [])).retryAfter, 1);
+  time += 999;
+  assert.equal(await second.take(volume, account), null);
+
+  const distributed = ["user", 3];
+  for (let i = 1; i <= 15; i++) {
+    assert.equal(await first.take(null, limits.loginFailures(distributed, `198.51.100.${i}`)), null);
+  }
+  assert.equal((await second.take(null, limits.loginFailures(distributed, "198.51.100.100"))).retryAfter, 900);
+  const capped = createAuthRateLimiter(file, () => time, 1);
+  assert.equal(await capped.take(null, [limits.recoveryAddress("original@example.test")]), null);
+  assert.equal((await capped.take(null, [limits.recoveryAddress("new@example.test")])).volumeLimited, true);
+  time += 900_000;
+  assert.equal(await capped.take(null, [limits.recoveryAddress("new@example.test")]), null);
+});
